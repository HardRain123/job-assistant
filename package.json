{
  "name": "job-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node --import tsx --watch apps/api/src/index.ts",
    "start": "node --import tsx apps/api/src/index.ts",
    "worker": "node --import tsx apps/browser-worker/src/index.ts",
    "bridge": "node --import tsx apps/codex-bridge/src/index.ts",
    "build": "node node_modules/vite/bin/vite.js build --config apps/web/vite.config.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.3.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "cheerio": "^1.1.2",
    "fastify": "^5.6.0",
    "mammoth": "^1.10.0",
    "pdf-parse": "^2.4.5",
    "playwright": "1.56.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.6",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
